# Copy to .env.local and source it before starting the Gateway.
# Keep this file free of real secrets.
GOOSECAB_DB=.data/goosecab.db
# HTTP, WebSocket and observer page listen on this same address.
GOOSECAB_ADDR=:8312
# GOOSECAB_AGENT_TOKEN=replace-with-a-long-random-value
# GOOSECAB_ALLOW_CROSS_ORIGIN=0
